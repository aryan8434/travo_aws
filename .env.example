# ---- Core ----
PORT=5000
# Long random string, min 16 chars. Auth fails to start without it.
JWT_SECRET=change-me-to-a-long-random-string

# ---- Database ----
# MongoDB connection string. App still runs (in-memory) if unset/unreachable.
MONGO_URI=mongodb://localhost:27017/travoai

# ---- LLM (intent extraction) ----
LLM_PROVIDER=groq
GROQ_API_KEY=
# Groq model. Default: openai/gpt-oss-20b (free/developer tier).
# llama-3.1-8b-instant was decommissioned by Groq on 2026-08-16.
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
# Gemini chat model (only used when LLM_PROVIDER=gemini). Default: gemini-flash-latest.
GEMINI_MODEL=gemini-flash-latest

# ---- RAG embeddings ----
# Optional. With a valid GEMINI_API_KEY, RAG embeds with GEMINI_EMBED_MODEL
# (default gemini-embedding-001, pinned to 768 dims). Without a key, an offline
# local embedding is used automatically.
GEMINI_EMBED_MODEL=gemini-embedding-001

# ---- External data providers (optional) ----
WEATHER_API_KEY=
MAKCORPS_API_TOKEN=

# ---- Payments ----
# Every charge is a flat ₹1 confirmation fee; the booking / wallet credit and
# the GST invoice are for the full amount.
#   PAYMENTS_MODE=live  → real Razorpay checkout (needs the keys below;
#                         rzp_test_... keys work perfectly, no real money).
#   PAYMENTS_MODE=test  → the ₹1 step auto-completes, no gateway call,
#                         invoice still raised. Default when keys are absent.
PAYMENTS_MODE=test
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# ---- Admin API ----
# Required to use /api/admin/* (reindex, chunks). Min 12 chars.
ADMIN_KEY=change-me-admin-key

# ---- CORS ----
# Comma-separated allowed origins. Defaults to localhost:3000/5000 if unset.
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ---- Seed user ----
# Password for the seeded 'test1234' demo account (min 6 chars).
SEED_TEST_PASSWORD=test12345
